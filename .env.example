# Copy to .env and fill in. All application settings use the THULE_ prefix.

# dev | prod. In prod the app refuses to start with default secrets or insecure cookies.
THULE_ENVIRONMENT=prod

# JWT signing key: at least 32 random bytes, e.g. `openssl rand -hex 32`.
THULE_SECRET_KEY=
# Fernet key that encrypts stored database passwords:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes existing connection passwords unreadable.
THULE_ENCRYPTION_KEY=

# true behind HTTPS (required in prod).
THULE_COOKIE_SECURE=true

# Allow connections to private / loopback addresses (self-hosted installs that
# connect to databases on the same network). Keep false for public SaaS (SSRF).
THULE_ALLOW_PRIVATE_DB_HOSTS=false

THULE_MAX_UPLOAD_MB=20
# Hard cap for any HTTP request body, enforced before routing.
THULE_MAX_REQUEST_MB=64
THULE_DB_STATEMENT_TIMEOUT_MS=15000
THULE_DB_QUERY_ROW_LIMIT=10000
# Approximate byte budget for a SQL-console result.
THULE_DB_QUERY_BYTE_LIMIT=16000000

# docker compose: password of the bundled PostgreSQL and the published port.
POSTGRES_PASSWORD=change-me
APP_BIND=127.0.0.1
APP_PORT=8010
